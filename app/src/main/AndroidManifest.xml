<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ========================= PERMISSIONS ========================= -->

    <!-- Draw over other apps — for floating button and translation overlay -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Foreground service — keeps the screen capture alive -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Media projection foreground service type — required for Android 14+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Post notifications — required for Android 13+ to show foreground service notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Internet — for potential cloud-based translation APIs -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ========================= APPLICATION ========================= -->

    <application
        android:name=".TranslateOnScreenApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TranslateOnScreen"
        tools:targetApi="34">

        <!-- Main Activity — single task to avoid multiple instances -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TranslateOnScreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Invisible launcher for the QS tile / status-bar shortcut -->
        <activity
            android:name=".TileLaunchActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:finishOnTaskLaunch="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.TranslateOnScreen.Transparent" />
        <service
            android:name=".service.ScreenCaptureService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="mediaProjection" />

        <service
            android:name=".service.TranslatorTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_c"
            android:label="@string/qs_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
